# Supabase 配置（可选，不配置则使用本地存储，无法跨设备同步）
# 从 Supabase Dashboard → Settings → API 获取
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 云同步用户 ID（完全免登录）：任意固定字符串，所有设备必须一致
# 生成方式：浏览器控制台执行 crypto.randomUUID()
# 注意：完全免登录意味着数据不设鉴权，仅靠页面地址保密
VITE_SYNC_USER_ID=your-sync-user-id
